# ==============================================================================
# DARK STUDIO PLATFORM — AUTONOMOUS MULTILINGUAL CONTENT ENGINE
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- AI & LLM Providers ---
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_PRO="gemini-2.5-pro"

# --- Neural Voice Synthesis (TTS) ---
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# --- Discovery & Stock B-Roll APIs ---
YOUTUBE_API_KEY="your_youtube_data_v3_api_key_here"
PEXELS_API_KEY="your_pexels_api_key_here"
PIXABAY_API_KEY="your_pixabay_api_key_here"

# --- YouTube OAuth2 & Publishing (Multi-Project Quota Scaling) ---
# Projeto 1 (Google Cloud Default - Ch1 A Via da Descoberta & Ch2 Finanças Quânticas: 10.000 un/dia)
YOUTUBE_CLIENT_SECRETS_FILE="client_secrets.json"
YOUTUBE_OAUTH_TOKEN_DIR="workspace/credentials"

# Projeto 2 (Dark Auth2 GCP - Ch3 Bio Hack Longevidade & Ch4 Ain't No Human Música: 10.000 un/dia)
DARK_AUTH2_CLIENT_ID="seu_client_id_dark_auth2_aqui"
DARK_AUTH2_CLIENT_SECRET="seu_client_secret_dark_auth2_aqui"
DARK_AUTH2_PROJECT_ID="seu_project_id_dark_auth2_aqui"
DARK_AUTH2_CLIENT_SECRETS_FILE="client_secrets_dark_auth2.json"

# --- Database & Server Settings ---
DATABASE_URL="sqlite:////home/eudespatricio/dark_studio_platform/dark_studio.db"
HOST="0.0.0.0"
PORT="8000"
LOG_LEVEL="INFO"

# --- Pipeline & Quality Thresholds ---
MIN_OUTLIER_SCORE="3.0"
MIN_PQS_SCORE="85.0"
WHISPER_MODEL_SIZE="base"
USE_NVENC="false"
